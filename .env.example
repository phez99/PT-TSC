# ============================================================
# PT. TRIMITRA SOLUSINDO CEMERLANG - ENVIRONMENT TEMPLATE
# ============================================================

# Environment Mode & Port
NODE_ENV=development

# Database MongoDB Cloud / Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tsc_erp_db?retryWrites=true&w=majority

# JWT Authentication Secret & Expire
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Client URL (CORS Allowed Origin)
CLIENT_URL=http://localhost:3000
VITE_USE_MOCK=false
VITE_API_URL=
